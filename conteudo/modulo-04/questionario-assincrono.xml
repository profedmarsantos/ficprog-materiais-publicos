<question type="multichoice"><name><text><![CDATA[M4-Q01]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo de aprendizagem:</strong> avaliar uma condição relacional.</p><p>Se int temperatura=38; qual expressão é verdadeira?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>38 é maior que 37.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><![CDATA[temperatura &gt; 37]]></text><feedback format="html"><text><![CDATA[<p>Correto. 38 é maior que 37.</p>]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[temperatura &lt; 37]]></text><feedback format="html"><text><![CDATA[<p>38 não é menor que 37.</p>]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[temperatura == 37]]></text><feedback format="html"><text><![CDATA[<p>38 e 37 não são iguais.</p>]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[temperatura &lt;= 37]]></text><feedback format="html"><text><![CDATA[<p>38 supera 37.</p>]]></text></feedback></answer><answer fraction="0" format="html"><text><![CDATA[temperatura != 38]]></text><feedback format="html"><text><![CDATA[<p>38 é igual a 38.</p>]]></text></feedback></answer></question>
