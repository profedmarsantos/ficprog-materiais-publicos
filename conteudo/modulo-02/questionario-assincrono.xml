<question type="multichoice"><name><text><![CDATA[M2-Q01 — Tipos]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> selecionar tipos adequados. Qual declaração armazena uma quantidade inteira e uma medida decimal?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p><code>int</code> armazena contagens inteiras; <code>float</code> preserva casas decimais.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>int quantidade; float medida;</code>]]></text><feedback><text><![CDATA[Correto: os tipos correspondem aos dados.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>float quantidade; int medida;</code>]]></text><feedback><text><![CDATA[Os tipos foram invertidos.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>int quantidade; int medida;</code>]]></text><feedback><text><![CDATA[A medida pode ter casas decimais.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>float quantidade; float medida;</code>]]></text><feedback><text><![CDATA[A quantidade é uma contagem inteira.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>char quantidade; float medida;</code>]]></text><feedback><text><![CDATA[char não é adequado para a contagem.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q02 — Atribuição]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> interpretar atribuição. Após <code>int total = 12; total = total + 5;</code>, qual é o valor de <code>total</code>?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>A expressão à direita é calculada antes de atualizar a variável.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[17]]></text><feedback><text><![CDATA[Correto: 12 mais 5 resulta em 17.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[12]]></text><feedback><text><![CDATA[A atribuição atualiza o valor.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[5]]></text><feedback><text><![CDATA[5 é apenas o valor somado.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[60]]></text><feedback><text><![CDATA[Não há multiplicação.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[Erro de sintaxe]]></text><feedback><text><![CDATA[Essa atribuição é válida em C.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q03 — Rastreamento]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> rastrear atribuições. Em <code>int a=4,b=9; a=b; b=a+2;</code>, quais são os valores finais?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>Primeiro a recebe 9; depois b recebe 9 mais 2.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>a=9</code> e <code>b=11</code>]]></text><feedback><text><![CDATA[Correto: siga a ordem das instruções.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>a=4</code> e <code>b=6</code>]]></text><feedback><text><![CDATA[a foi atualizado antes de b.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>a=9</code> e <code>b=9</code>]]></text><feedback><text><![CDATA[b recebe a mais 2.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>a=11</code> e <code>b=9</code>]]></text><feedback><text><![CDATA[A última instrução altera b.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>a=4</code> e <code>b=11</code>]]></text><feedback><text><![CDATA[a já recebeu o valor de b.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q04 — Divisão]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> analisar divisão. Qual expressão produz 2.5 para <code>int soma=5;</code> e <code>int quantidade=2;</code>?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>Um operando real faz a divisão preservar a parte decimal.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>float media=soma/2.0;</code>]]></text><feedback><text><![CDATA[Correto: 2.0 torna a divisão real.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>int media=soma/quantidade;</code>]]></text><feedback><text><![CDATA[A divisão seria inteira.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>float media=soma/quantidade;</code>]]></text><feedback><text><![CDATA[int por int já resulta em inteiro.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>float media=soma%quantidade;</code>]]></text><feedback><text><![CDATA[% calcula o resto.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>float media=soma*quantidade;</code>]]></text><feedback><text><![CDATA[Multiplicação não calcula média.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q05 — Média]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> construir expressão. Qual linha calcula a média de <code>n1</code> e <code>n2</code>?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>Os parênteses garantem a soma antes da divisão.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>media=(n1+n2)/2.0;</code>]]></text><feedback><text><![CDATA[Correto: soma, depois divide.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>media=n1+n2/2.0;</code>]]></text><feedback><text><![CDATA[Só n2 seria dividido.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>media=n1+(n2/2.0);</code>]]></text><feedback><text><![CDATA[Não corrige a fórmula.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>media=(n1+n2)*2.0;</code>]]></text><feedback><text><![CDATA[A média exige divisão.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>media=n1/n2/2.0;</code>]]></text><feedback><text><![CDATA[Essa expressão não soma os valores.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q06 — Desconto]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> modelar cálculo. Um produto de <code>preco</code> recebe desconto de 10%. Qual é o valor final?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p>Após desconto de 10%, permanecem 90% do preço.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>final=preco*0.90;</code>]]></text><feedback><text><![CDATA[Correto: permanece 90% do preço.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>final=preco*0.10;</code>]]></text><feedback><text><![CDATA[Isso calcula apenas o desconto.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>final=preco+0.10;</code>]]></text><feedback><text><![CDATA[10% não é somar 0.10.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>final=preco-0.90;</code>]]></text><feedback><text><![CDATA[Isso não representa porcentagem.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>final=preco/0.90;</code>]]></text><feedback><text><![CDATA[Dividir por 0.90 aumenta o valor.]]></text></feedback></answer></question>
<question type="multichoice"><name><text><![CDATA[M2-Q07 — printf]]></text></name><questiontext format="html"><text><![CDATA[<p><strong>Objetivo:</strong> selecionar saída. Qual comando exibe <code>float valor</code> com duas casas decimais?</p>]]></text></questiontext><generalfeedback format="html"><text><![CDATA[<p><code>%.2f</code> é o formato de float com duas casas decimais.</p>]]></text></generalfeedback><defaultgrade>1</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100"><text><![CDATA[<code>printf("%.2f", valor);</code>]]></text><feedback><text><![CDATA[Correto: .2 define duas casas.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>printf("%d", valor);</code>]]></text><feedback><text><![CDATA[%d é para int.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>printf("%2d", valor);</code>]]></text><feedback><text><![CDATA[%2d não formata float.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>printf("%f.2", valor);</code>]]></text><feedback><text><![CDATA[A precisão vem antes de f.]]></text></feedback></answer><answer fraction="0"><text><![CDATA[<code>printf("%c", valor);</code>]]></text><feedback><text><![CDATA[%c é para char.]]></text></feedback></answer></question>
